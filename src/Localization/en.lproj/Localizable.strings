// ---------- RENDER ENGINE CREATOR — NODES (ec.n.) ----------
"ec.n.abs" = "Absolute value";
"ec.n.abs.help" = "Absolute value of a.";
"ec.n.abs.use" = "Outputs the absolute value of a, dropping the minus sign. Use it to get a distance regardless of direction.";
"ec.n.add" = "Add";
"ec.n.add.help" = "Sum: a + b.";
"ec.n.add.use" = "Outputs the sum of a and b. Connect two float outputs to a and b.";
"ec.n.addColor" = "Add colors";
"ec.n.addColor.help" = "Adds the channels of two colors, clamped to the valid range.";
"ec.n.addColor.use" = "Adds the channels of colors a and b, clamped to the valid range. Use it to brighten one color with another.";
"ec.n.and" = "And";
"ec.n.and.help" = "True if both conditions are true.";
"ec.n.and.use" = "Outputs yes only when both a and b are yes. Connect two conditions to a and b.";
"ec.n.asinh" = "Inverse sinh";
"ec.n.asinh.help" = "Inverse hyperbolic sine. Used to turn perceived distance back into flat distance in hyperbolic passes.";
"ec.n.asinh.use" = "Outputs the inverse hyperbolic sine of a. Use it to turn perceived distance back into flat distance in hyperbolic passes.";
"ec.n.atan" = "Arctangent";
"ec.n.atan.help" = "Arctangent of a.";
"ec.n.atan.use" = "Outputs the arctangent of a as an angle in radians. Use it to turn a slope or ratio back into an angle.";
"ec.n.brightness" = "Brightness";
"ec.n.brightness.help" = "Multiplies color brightness by k. k=1 unchanged, k=0.5 half as bright.";
"ec.n.brightness.use" = "Multiplies the color on c by k. k 1 leaves it unchanged, k 0.5 makes it half as bright, and values above 1 brighten it.";
"ec.n.cameraAngle" = "Camera angle";
"ec.n.cameraAngle.help" = "Player view direction (radians).";
"ec.n.cameraAngle.use" = "Source with no inputs: out gives the player view direction in radians. Connect it to the cameraAngle input of Ray direction to aim the rays along the view.";
"ec.n.cameraHeight" = "Camera height";
"ec.n.cameraHeight.help" = "Camera height from the game settings.";
"ec.n.cameraHeight.use" = "Source with no inputs: out gives the camera height from the game settings. Use it in any calculation that needs the camera height.";
"ec.n.cameraPitch" = "Camera pitch";
"ec.n.cameraPitch.help" = "Camera tilt up or down.";
"ec.n.cameraPitch.use" = "Source with no inputs: out gives the camera tilt up or down. Use it in calculations that need the view tilt.";
"ec.n.cameraPose" = "Camera pose";
"ec.n.cameraPose.help" = "The camera's angle, height and pitch in one node.";
"ec.n.cameraPose.use" = "Source with no inputs: angle, height and pitch of the view, read together. Connect them where a camera value is needed, or use the one you need.";
"ec.n.ceil" = "Round up";
"ec.n.ceil.help" = "Rounds a up to a whole number.";
"ec.n.ceil.use" = "Rounds a up to the next whole number. Use it when a value must never fall below a whole step.";
"ec.n.checker" = "Checkerboard";
"ec.n.checker.help" = "0 or 1 in a chessboard pattern over (u, v); scale sets the float of squares per unit.";
"ec.n.checker.use" = "Outputs 0 or 1 in a chessboard pattern over u and v. Set scale to change how many squares fit per unit.";
"ec.n.clamp" = "Clamp";
"ec.n.clamp.help" = "Limits x to the range lo to hi.";
"ec.n.clamp.use" = "Limits x to the range from lo to hi, so the output never goes below lo or above hi. Connect the value to x and set the bounds on lo and hi.";
"ec.n.constBool" = "Constant boolean";
"ec.n.constBool.help" = "A fixed true or false value.";
"ec.n.constBool.use" = "Source with no inputs: outputs the fixed boolean value set in value. Connect it to any boolean input.";
"ec.n.constColor" = "Color (constant)";
"ec.n.constColor.help" = "Constant color. Set it in the properties on the right.";
"ec.n.constColor.use" = "Source with no inputs: outputs the fixed color set in color on the right. Connect it to any color input, such as Brightness or Mix colors.";
"ec.n.constFloat" = "Constant float";
"ec.n.constFloat.help" = "Constant float. Set the value in the properties on the right.";
"ec.n.constFloat.use" = "Source with no inputs: outputs the fixed float set in value on the right. Connect it to any float input that needs a constant.";
"ec.n.constInt" = "Constant integer";
"ec.n.constInt.help" = "Constant integer.";
"ec.n.constInt.use" = "Source with no inputs: outputs the fixed whole number set in value on the right. Use it where an integer input needs a constant.";
"ec.n.cos" = "Cosine";
"ec.n.cos.help" = "Cosine of a (a in radians).";
"ec.n.cos.use" = "Outputs the cosine of a, with a in radians. Pair it with Sine to move a point around a circle.";
"ec.n.curvature" = "Curvature";
"ec.n.curvature.help" = "Curvature of the hyperbolic space from the game settings (radius).";
"ec.n.curvature.use" = "Source with no inputs: out gives the curvature of hyperbolic space from the game settings. Connect it to k of Hyperbolic distance.";
"ec.n.div" = "Divide";
"ec.n.div.help" = "a divided by b. If b = 0 the result is 0 (no error).";
"ec.n.div.use" = "Outputs a divided by b. If b is 0 the result is 0, so check b first if zero is a possible input.";
"ec.n.dot3" = "Dot product (3D)";
"ec.n.dot3.help" = "a·b for two vectors given as x, y, z. Negative results are kept; chain Max with 0 for light.";
"ec.n.dot3.use" = "Outputs the dot product of vectors a (ax, ay, az) and b (bx, by, bz). Negative results are kept, so chain Max with 0 for light.";
"ec.n.equalInt" = "Equal (integers)";
"ec.n.equalInt.help" = "True when two whole numbers are equal.";
"ec.n.equalInt.use" = "Outputs yes when the whole numbers a and b are equal. Use it to test cell or pixel indexes.";
"ec.n.exp" = "Exponential";
"ec.n.exp.help" = "e to the power of a.";
"ec.n.exp.use" = "Outputs e raised to the power of a. Connect a negative a for a fast falloff.";
"ec.n.floor" = "Round down";
"ec.n.floor.help" = "Largest whole number not above a.";
"ec.n.floor.use" = "Rounds a down to the nearest whole number. Use it to make steps or to split off the whole part of a value.";
"ec.n.fog" = "Fog";
"ec.n.fog.help" = "Blends the color with fog color: the farther (distance), the thicker the fog.";
"ec.n.fog.use" = "Blends color c towards fogColor, with more fog at a greater distance, controlled by density. Connect the distance from a ray hit to distance.";
"ec.n.fract" = "Fractional part";
"ec.n.fract.help" = "Fractional part of a: repeats values from 0 to 1.";
"ec.n.fract.use" = "Outputs the fractional part of a, repeating from 0 to 1. Connect a growing value such as time to get a repeating ramp.";
"ec.n.gameLight" = "Game light";
"ec.n.gameLight.help" = "The game's shading light in one node: attenuation, flashlight, fill and ambient per channel. Inputs: distance, ambient occlusion, light angle, fill angle, finish flag.";
"ec.n.gameLight.use" = "Applies the game's shading light. Connect the distance, ao, ndl, ndf and finish inputs, then use r, g, b or level as the light values.";
"ec.n.grayscale" = "Grayscale";
"ec.n.grayscale.help" = "Removes color and keeps the brightness.";
"ec.n.grayscale.use" = "Removes the color from c and keeps its brightness as a grey color. Use it to desaturate a surface.";
"ec.n.greater" = "Greater than";
"ec.n.greater.help" = "True if a is greater than b.";
"ec.n.greater.use" = "Outputs yes when a is greater than b. Use it as a condition for Select or other boolean inputs.";
"ec.n.greaterEq" = "Greater or equal";
"ec.n.greaterEq.help" = "True when a ≥ b.";
"ec.n.greaterEq.use" = "Outputs yes when a is greater than or equal to b. Use it as a condition for Select or logic nodes.";
"ec.n.hash" = "Hash noise";
"ec.n.hash.help" = "Pseudo-random float 0 to 1 for point x, y and seed. Same inputs give the same value.";
"ec.n.hash.use" = "Outputs a pseudo-random number from 0 to 1 for the point x, y and seed. The same inputs always give the same value, so change seed for a different pattern.";
"ec.n.height" = "Height";
"ec.n.height.help" = "Picture height in pixels.";
"ec.n.height.use" = "Source with no inputs: out gives the picture height in pixels. Use it wherever a calculation needs the image size, for example together with width.";
"ec.n.hypDistance" = "Hyperbolic distance";
"ec.n.hypDistance.help" = "Converts flat distance t to hyperbolic distance: k·sinh(t/k).";
"ec.n.hypDistance.use" = "Converts flat distance t into hyperbolic distance using k, which is k times sinh of t divided by k. Connect a distance to t and the curvature to k.";
"ec.n.hyperbolic" = "Hyperbolic mode";
"ec.n.hyperbolic.help" = "True when the game is drawing in hyperbolic geometry now.";
"ec.n.hyperbolic.use" = "Source with no inputs: out is yes while the game draws in hyperbolic geometry. Connect it to a boolean input such as cond of Select to switch behaviour.";
"ec.n.invertColor" = "Invert color";
"ec.n.invertColor.help" = "Negative of a color: each channel becomes 1 minus its value.";
"ec.n.invertColor.use" = "Outputs the negative of color c, with each channel becoming 1 minus its value. Connect any color to c.";
"ec.n.isWall" = "Is wall";
"ec.n.isWall.help" = "True when the map cell (x, y) is a wall.";
"ec.n.isWall.use" = "Outputs yes when the map cell at x, y is a wall. Connect whole-float coordinates to x and y.";
"ec.n.length3" = "Length (3D)";
"ec.n.length3.help" = "Length of the vector (x, y, z).";
"ec.n.length3.use" = "Outputs the length of the vector given by x, y and z. Use it to measure the size of a 3D direction.";
"ec.n.less" = "Less than";
"ec.n.less.help" = "True if a is less than b.";
"ec.n.less.use" = "Outputs yes when a is less than b. Connect the result to a condition input such as cond of Select, or to And, Or or Not.";
"ec.n.lessEq" = "Less or equal";
"ec.n.lessEq.help" = "True when a ≤ b.";
"ec.n.lessEq.use" = "Outputs yes when a is less than or equal to b. Use it as a condition for Select or logic nodes.";
"ec.n.litColor" = "Lit color";
"ec.n.litColor.help" = "Color times the light per channel, then the game's tone curve. Output is a color.";
"ec.n.litColor.use" = "Multiplies color c by the light values r, g and b per channel, then applies the game's tone curve. Connect the r, g and b outputs of Game light.";
"ec.n.luma" = "Luminance";
"ec.n.luma.help" = "Brightness of a color (0.299 R + 0.587 G + 0.114 B) as a float from 0 to 1.";
"ec.n.luma.use" = "Outputs the brightness of color c as a float from 0 to 1 using standard luminance weights. Connect it to any float input that needs a brightness value.";
"ec.n.makeColor" = "Make color";
"ec.n.makeColor.help" = "Color from red, green and blue (each 0 to 1).";
"ec.n.makeColor.use" = "Builds a color from r, g and b, each from 0 to 1, and outputs it as out. Connect three float outputs to r, g and b.";
"ec.n.mapCell" = "Map cell";
"ec.n.mapCell.help" = "Map cell type at x, y: 0 empty, 1 and up wall, -1 outside the map.";
"ec.n.mapCell.use" = "Looks up the map cell at x, y and outputs its type: 0 is empty, 1 and up is a wall, -1 is outside the map. Connect whole-float coordinates to x and y.";
"ec.n.marchRounded" = "Rounded march";
"ec.n.marchRounded.help" = "Sphere tracing over the map against walls with rounded convex corners (outer radius) and filleted concave corners (inner radius). Stops at the first wall. Portal cells are empty here, so rays pass them.";
"ec.n.marchRounded.use" = "Traces a ray over the map with rounded wall corners (outerRadius) and filleted inner corners (innerRadius), stopping at the first wall. Use hit, distance, side and normal outputs for shading.";
"ec.n.max" = "Maximum";
"ec.n.max.help" = "The larger of a and b.";
"ec.n.max.use" = "Outputs the larger of a and b. Use it to set a minimum, for example with 0 to remove negative values.";
"ec.n.min" = "Minimum";
"ec.n.min.help" = "The smaller of a and b.";
"ec.n.min.use" = "Outputs the smaller of a and b. Use it to cap a value at a maximum.";
"ec.n.mix" = "Mix floats";
"ec.n.mix.help" = "Smooth blend from a to b: t=0 gives a, t=1 gives b.";
"ec.n.mix.use" = "Blends from a to b using t: t 0 gives a, t 1 gives b, and values between give a smooth mix. Drive t with a 0 to 1 value such as Wave.";
"ec.n.mixColor" = "Mix colors";
"ec.n.mixColor.help" = "Blends two colors: t=0 gives a, t=1 gives b.";
"ec.n.mixColor.use" = "Blends color a into color b by t: t 0 gives a, t 1 gives b. Drive t with a float between 0 and 1.";
"ec.n.mod" = "Modulo";
"ec.n.mod.help" = "Remainder a mod b, always in [0, b): repeats a pattern every b.";
"ec.n.mod.use" = "Outputs the remainder of a divided by b, always from 0 up to b. Use it to repeat a pattern every b units.";
"ec.n.mul" = "Multiply";
"ec.n.mul.help" = "Product: a × b.";
"ec.n.mul.use" = "Outputs a times b. Use it to scale one float by another, for example a value by a constant.";
"ec.n.multiplyColor" = "Multiply colors";
"ec.n.multiplyColor.help" = "Multiplies the channels of two colors: a light tints a surface.";
"ec.n.multiplyColor.use" = "Multiplies the channels of colors a and b. Put a light color in b to tint the surface color in a.";
"ec.n.neg" = "Negate";
"ec.n.neg.help" = "Flips the sign of a float.";
"ec.n.neg.use" = "Flips the sign of the float on a. Connect any float to a to get its negative.";
"ec.n.neighbor" = "Neighbour pixel of the previous pass";
"ec.n.neighbor.help" = "Color of the previous pass pixel shifted by dx, dy. Available from the second pass.";
"ec.n.neighbor.use" = "Source with no inputs: outputs the color of the previous pass pixel shifted by dx and dy. It only works from the second pass, so use it for blur or feedback effects.";
"ec.n.not" = "Not";
"ec.n.not.help" = "Turns true into false and back.";
"ec.n.not.use" = "Inverts the boolean value on a. Connect a condition to a to get its opposite.";
"ec.n.or" = "Or";
"ec.n.or.help" = "True if at least one condition is true.";
"ec.n.or.use" = "Outputs yes when a or b, or both, is yes. Use it to combine two conditions.";
"ec.n.output" = "Output";
"ec.n.output.help" = "Final color of the pixel. Each pass needs exactly one such node.";
"ec.n.output.use" = "Sink: takes the final color of the pixel on color. Each pass needs exactly one Output node.";
"ec.n.pixelX" = "Pixel X";
"ec.n.pixelX.help" = "Column index of the pixel (integer).";
"ec.n.pixelX.use" = "Source with no inputs: read out to get the pixel column index as a whole number. Connect it to math or color nodes to build patterns that vary by column.";
"ec.n.pixelY" = "Pixel Y";
"ec.n.pixelY.help" = "Row index of the pixel (integer).";
"ec.n.pixelY.use" = "Source with no inputs: out gives the pixel row index as a whole number. Connect it to math or color nodes to build patterns that vary by row.";
"ec.n.playerPosition" = "Player position";
"ec.n.playerPosition.help" = "The player's map position, x and y, in one node.";
"ec.n.playerPosition.use" = "Source with no inputs: x and y give the player's horizontal map position, read together. Connect both to Grid ray or Rounded march to cast rays from the player.";
"ec.n.playerX" = "Player X";
"ec.n.playerX.help" = "Player position on the map, horizontal.";
"ec.n.playerX.use" = "Source with no inputs: out gives the player horizontal map position. Connect it to originX of Grid ray or Rounded march to cast rays from the player.";
"ec.n.playerY" = "Player Y";
"ec.n.playerY.help" = "Player position on the map, vertical.";
"ec.n.playerY.use" = "Source with no inputs: out gives the player vertical map position. Connect it to originY of Grid ray or Rounded march to cast rays from the player.";
"ec.n.pointOnRay" = "Point on ray";
"ec.n.pointOnRay.help" = "Point origin + direction · t. Gives the hit position from the ray distance.";
"ec.n.pointOnRay.use" = "Computes origin plus direction times t, giving the point x and y. Connect a ray's origin, direction and hit distance to get the hit position.";
"ec.n.posterize" = "Posterize";
"ec.n.posterize.help" = "Reduces the float of shades in each channel to levels steps.";
"ec.n.posterize.use" = "Reduces the shades in each channel of c to the float of steps in levels, giving a flat banded look. Set levels to a step count such as 4.";
"ec.n.pow" = "Power";
"ec.n.pow.help" = "a to the power of b.";
"ec.n.pow.use" = "Outputs a raised to the power b. Connect the exponent to b.";
"ec.n.quality" = "Quality";
"ec.n.quality.help" = "Quality level from the game settings.";
"ec.n.quality.use" = "Source with no inputs: out gives the quality level set in the game settings as a whole number. Use it to make an effect richer or cheaper depending on the setting.";
"ec.n.radius" = "Radius";
"ec.n.radius.help" = "Distance from the screen centre to (x, y): useful for vignettes and round lights.";
"ec.n.radius.use" = "Outputs the distance from the screen centre to x, y. Use it for vignettes or round lights.";
"ec.n.rayDirection" = "Ray direction";
"ec.n.rayDirection.help" = "Ray direction for a screen column. Takes screenX and camera angle, gives dirX and dirY.";
"ec.n.rayDirection.use" = "Gives the ray direction dirX and dirY for a screen column. Connect screenX and cameraAngle, and set the field of view in fov.";
"ec.n.rayGrid" = "Grid ray";
"ec.n.rayGrid.help" = "Casts a ray through map cells from origin along dir. Gives the distance to the wall and the hit position.";
"ec.n.rayGrid.use" = "Casts a ray from originX, originY along dirX, dirY through map cells. Use hit to see if it hit a wall, distance for its length and hitU for the position on the wall. maxSteps limits the search.";
"ec.n.rayGridPortal" = "Grid ray (portals)";
"ec.n.rayGridPortal.help" = "Like Grid ray, but the ray passes through portal cells and continues from the linked cell. Use it instead of Grid ray in maps with portals.";
"ec.n.rayGridPortal.use" = "Like Grid ray, but the ray passes through portal cells and continues from the linked cell. Use it instead of Grid ray in maps with portals. maxSteps limits the search.";
"ec.n.reflect2" = "Reflect direction";
"ec.n.reflect2.help" = "Reflects a direction off a surface with normal (nx, ny). Use it for mirrors and shiny floors.";
"ec.n.reflect2.use" = "Reflects the direction dirX, dirY off a surface with normal nx, ny and outputs rx, ry. Use it for mirrors and shiny floors.";
"ec.n.round" = "Round";
"ec.n.round.help" = "Rounds a to the nearest whole number.";
"ec.n.round.use" = "Rounds a to the nearest whole number. Use it to snap a value to whole steps.";
"ec.n.sampleTexture" = "Texture color";
"ec.n.sampleTexture.help" = "Texture color at u, v (0 to 1, repeats). Choose the texture in properties.";
"ec.n.sampleTexture.use" = "Outputs the color of the chosen texture at u and v, which range from 0 to 1 and repeat. Pick the texture in texture on the right.";
"ec.n.schlick" = "Schlick";
"ec.n.schlick.help" = "Fresnel approximation (1 - cosine)^5: edges reflect more than the centre.";
"ec.n.schlick.use" = "Gives a Fresnel-style edge effect from cosine, so edges come out stronger than the centre. Connect a cosine value, often from a dot product.";
"ec.n.screenX" = "Screen X";
"ec.n.screenX.help" = "Horizontal position: -1 (left edge) to 1 (right edge).";
"ec.n.screenX.use" = "Source with no inputs: out gives the horizontal screen position from -1 at the left edge to 1 at the right edge. Use it for gradients or shapes across the screen.";
"ec.n.screenY" = "Screen Y";
"ec.n.screenY.help" = "Vertical position: -1 (bottom) to 1 (top).";
"ec.n.screenY.use" = "Source with no inputs: out gives the vertical screen position from -1 at the bottom to 1 at the top. Use it for vertical gradients or combine it with screenX.";
"ec.n.sdfBox" = "Box distance";
"ec.n.sdfBox.help" = "Distance from point (px, py, pz) to a box with half-sizes (hx, hy, hz) centred at 0. Negative inside.";
"ec.n.sdfBox.use" = "Outputs the distance d from point px, py, pz to a box with half sizes hx, hy, hz centred at 0. Negative means inside the box.";
"ec.n.select" = "Select";
"ec.n.select.help" = "If cond is true, outputs a, otherwise b. Inputs a and b must have the same type.";
"ec.n.select.use" = "If cond is yes, outputs a; otherwise outputs b. Connect a and b with the same type, for example two floats or two colors.";
"ec.n.sign" = "Sign";
"ec.n.sign.help" = "-1 for negative, 1 for positive, 0 for zero.";
"ec.n.sign.use" = "Outputs -1 for negative a, 1 for positive a and 0 for zero. Use it to find which side of zero a value is on.";
"ec.n.sin" = "Sine";
"ec.n.sin.help" = "Sine of a (a in radians).";
"ec.n.sin.use" = "Outputs the sine of a, with a in radians. Connect a time or angle value to a to get a smooth wave between -1 and 1.";
"ec.n.smoothMin" = "Smooth min";
"ec.n.smoothMin.help" = "Blends two distances with softness k: round, merged corners instead of hard joins.";
"ec.n.smoothMin.use" = "Blends two distances a and b with softness k so joins look rounded and merged instead of hard. A larger k gives a softer blend.";
"ec.n.smoothstep" = "Smoothstep";
"ec.n.smoothstep.help" = "Smooth 0..1 transition between edge0 and edge1 (soft threshold).";
"ec.n.smoothstep.use" = "Outputs a smooth 0 to 1 transition as x moves between edge0 and edge1, a soft threshold. Set the two edges and connect the value to x.";
"ec.n.splitColor" = "Split color";
"ec.n.splitColor.help" = "Color split into three floats r, g, b (each 0 to 1).";
"ec.n.splitColor.use" = "Splits the color on c into three floats r, g and b from 0 to 1. Use it to adjust one channel, then recombine with Make color.";
"ec.n.sqrt" = "Square root";
"ec.n.sqrt.help" = "Square root of a (negative input gives 0).";
"ec.n.sqrt.use" = "Outputs the square root of a. A negative a gives 0, so keep the input non-negative where that matters.";
"ec.n.step" = "Step";
"ec.n.step.help" = "0 while x is below edge, 1 from edge on. A hard threshold.";
"ec.n.step.use" = "Outputs 0 while x is below edge and 1 from edge on, a hard threshold. Set edge and connect the value to x.";
"ec.n.sub" = "Subtract";
"ec.n.sub.help" = "Difference: a − b.";
"ec.n.sub.use" = "Outputs a minus b. Connect the value to subtract to b.";
"ec.n.tan" = "Tangent";
"ec.n.tan.help" = "Tangent of a (a in radians).";
"ec.n.tan.use" = "Outputs the tangent of the angle on a in radians. Values become very large near odd multiples of pi divided by 2.";
"ec.n.th.abs" = "Absolute value";
"ec.n.th.abs.help" = "Absolute value of a.";
"ec.n.th.abs.use" = "Outputs the absolute value of a, dropping any minus sign. Use it to get a size regardless of direction.";
"ec.n.th.add" = "Add";
"ec.n.th.add.help" = "Sum: a + b.";
"ec.n.th.add.use" = "Outputs a plus b. Set a and b on the right or connect values to them.";
"ec.n.th.addColor" = "Add colors";
"ec.n.th.addColor.help" = "Adds two colors channel by channel.";
"ec.n.th.addColor.use" = "Adds two colors channel by channel. Set a and b on the right or connect colors to them.";
"ec.n.th.alpha" = "Color alpha";
"ec.n.th.alpha.help" = "The color with its transparency set to a (0–1).";
"ec.n.th.alpha.use" = "Outputs the color with its transparency set to a, from 0 to 1. Connect a float to a to fade the color.";
"ec.n.th.and" = "And";
"ec.n.th.and.help" = "True when both a and b are true.";
"ec.n.th.and.use" = "Outputs yes only when both a and b are yes. Connect two conditions to a and b.";
"ec.n.th.atan2" = "Angle atan2";
"ec.n.th.atan2.help" = "Angle of the point (b, a) in radians; a is y, b is x.";
"ec.n.th.atan2.use" = "Outputs the angle of the point with x equal to b and y equal to a, in radians. Connect the y offset to a and the x offset to b.";
"ec.n.th.axis" = "Key axis";
"ec.n.th.axis.help" = "-1 while the negative key is held, 1 while the positive key is held, 0 otherwise.";
"ec.n.th.axis.use" = "Source with no inputs: outputs -1 while the negative key is held, 1 while the positive key is held, 0 otherwise. Set the keys in negative and positive.";
"ec.n.th.beat" = "Beat phase";
"ec.n.th.beat.help" = "Beat phase from 0 to 1: rises at the BPM rate and restarts every bar.";
"ec.n.th.beat.use" = "Source with no inputs: outputs a beat phase from 0 to 1 that rises at the bpm rate and restarts each bar. Use it to sync pulses to a tempo.";
"ec.n.th.bool" = "Boolean";
"ec.n.th.bool.help" = "A boolean value. In a float input it counts as 1 or 0.";
"ec.n.th.bool.use" = "Source with no inputs: outputs the boolean value set in value. In a float input it counts as 1 or 0.";
"ec.n.th.boxMask" = "Box mask";
"ec.n.th.boxMask.help" = "1 inside the box, 0 outside, with a soft edge.";
"ec.n.th.boxMask.use" = "Outputs 1 inside a box at x, y with half sizes halfWidth and halfHeight and 0 outside, with a soft edge set by softness.";
"ec.n.th.bright" = "Brightness";
"ec.n.th.bright.help" = "Color times k: below 1 darker, above 1 brighter.";
"ec.n.th.bright.use" = "Multiplies the color by k: below 1 is darker, above 1 is brighter. Connect a factor to k.";
"ec.n.th.ceil" = "Round up";
"ec.n.th.ceil.help" = "Smallest whole number not below a.";
"ec.n.th.ceil.use" = "Outputs the smallest whole number not below a, so it rounds up. Use it to snap a value up to whole steps.";
"ec.n.th.channel" = "Color channel";
"ec.n.th.channel.help" = "One color component (r, g, b or a) from 0 to 1.";
"ec.n.th.channel.use" = "Outputs one component of the color from 0 to 1: set channel to r, g, b or a. Connect a color to color to read one channel.";
"ec.n.th.checker" = "Checker";
"ec.n.th.checker.help" = "Checkerboard: 0 and 1 on cells of size 1/scale.";
"ec.n.th.checker.use" = "Outputs a checkerboard of 0 and 1 over x and y, with cells of size 1 over scale. Use it for tiles or grid patterns.";
"ec.n.th.circleMask" = "Circle mask";
"ec.n.th.circleMask.help" = "1 inside the circle, 0 outside, with a soft edge of softness.";
"ec.n.th.circleMask.use" = "Outputs 1 inside a circle at x, y with the given radius and 0 outside, with a soft edge set by softness. Use it for round shapes.";
"ec.n.th.clamp" = "Clamp";
"ec.n.th.clamp.help" = "Limits a to the range lo to hi.";
"ec.n.th.clamp.use" = "Limits a to the range lo to hi, so the output stays within those bounds. Set lo and hi on the right or connect them.";
"ec.n.th.color" = "Color (constant)";
"ec.n.th.color.help" = "A constant color. Set it in the properties on the right.";
"ec.n.th.color.use" = "Source with no inputs: outputs the constant color set in color on the right. Connect it to any color input.";
"ec.n.th.cos" = "Cosine";
"ec.n.th.cos.help" = "Cosine of a (radians).";
"ec.n.th.cos.use" = "Outputs the cosine of a, with a in radians. Pair it with Sine to move a point around a circle.";
"ec.n.th.counter" = "Counter";
"ec.n.th.counter.help" = "Counts the rising edges of the input.";
"ec.n.th.counter.use" = "Counts the rising edges of in and outputs the count as a float. Use it to count presses or events.";
"ec.n.th.deg" = "To degrees";
"ec.n.th.deg.help" = "Converts a from radians to degrees.";
"ec.n.th.deg.use" = "Converts the angle on a from radians to degrees. Use it where a rotation or angle must be shown in degrees.";
"ec.n.th.distance" = "Distance";
"ec.n.th.distance.help" = "Distance between the points (x1, y1) and (x2, y2).";
"ec.n.th.distance.use" = "Outputs the distance between the points x1, y1 and x2, y2. Connect the two points' coordinates to these inputs.";
"ec.n.th.div" = "Divide";
"ec.n.th.div.help" = "Quotient: a ÷ b. Division by zero gives 0.";
"ec.n.th.div.use" = "Outputs a divided by b. Division by zero gives 0, so a zero b is safe but returns 0.";
"ec.n.th.dt" = "Frame time";
"ec.n.th.dt.help" = "Seconds since the previous frame.";
"ec.n.th.dt.use" = "Source with no inputs: outputs the seconds since the previous frame. Multiply a speed by it to keep movement steady across frame rates.";
"ec.n.th.ease" = "Ease";
"ec.n.th.ease.help" = "Smooth curve of a from 0 to 1, slow at both ends.";
"ec.n.th.ease.use" = "Outputs a smooth curve from 0 to 1 for a, slow at both ends. Connect a value from 0 to 1 to ease a movement.";
"ec.n.th.easeIn" = "Ease in";
"ec.n.th.easeIn.help" = "Cubic ease-in from 0 to 1 (slow start).";
"ec.n.th.easeIn.use" = "Outputs a cubic ease-in curve from 0 to 1 for x, slow at the start. Connect a value from 0 to 1 for a gentle start to a move.";
"ec.n.th.easeInOut" = "Ease in-out";
"ec.n.th.easeInOut.help" = "Smooth start and finish from 0 to 1.";
"ec.n.th.easeInOut.use" = "Outputs a curve from 0 to 1 for x that is smooth at both start and finish. Connect a value from 0 to 1 for a natural-looking move.";
"ec.n.th.easeOut" = "Ease out";
"ec.n.th.easeOut.help" = "Cubic ease-out from 0 to 1 (slow finish).";
"ec.n.th.easeOut.use" = "Outputs a cubic ease-out curve from 0 to 1 for x, slow at the finish. Connect a value from 0 to 1 for a movement that settles.";
"ec.n.th.edge" = "Rising edge";
"ec.n.th.edge.help" = "True for one frame when the input goes from false to true.";
"ec.n.th.edge.use" = "Outputs yes for one frame when the input changes from no to yes. Connect a condition to in to trigger a one-shot action.";
"ec.n.th.eq" = "Equal";
"ec.n.th.eq.help" = "True when a equals b.";
"ec.n.th.eq.use" = "Outputs yes when a equals b exactly. For floats use Equal with tolerance instead.";
"ec.n.th.equal" = "Equal (with tolerance)";
"ec.n.th.equal.help" = "True when a and b differ by no more than tolerance.";
"ec.n.th.equal.use" = "Outputs yes when a and b differ by no more than tolerance. Use it to compare floats safely.";
"ec.n.th.exp" = "Exponent";
"ec.n.th.exp.help" = "e raised to the power a.";
"ec.n.th.exp.use" = "Outputs e raised to the power of a. Connect a negative a for a fast falloff.";
"ec.n.th.fbm" = "Fractal noise";
"ec.n.th.fbm.help" = "Noise made of several layered scales (octaves): richer than plain noise.";
"ec.n.th.fbm.use" = "Outputs fractal noise over x and y, layering several noise scales set by octaves. More octaves give a richer pattern.";
"ec.n.th.floor" = "Floor";
"ec.n.th.floor.help" = "The largest whole number not above a.";
"ec.n.th.floor.use" = "Outputs the largest whole number not above a. Use it to snap a value down to whole steps.";
"ec.n.th.follow" = "Smooth";
"ec.n.th.follow.help" = "Follows x over time, kept between frames. speed sets how fast it catches up (higher is quicker).";
"ec.n.th.follow.use" = "Follows x over time and keeps its value between frames. A higher speed makes it catch up faster, so connect a jumping value to x to smooth it.";
"ec.n.th.fract" = "Fraction";
"ec.n.th.fract.help" = "The part of a after the whole number, from 0 up to 1.";
"ec.n.th.fract.use" = "Outputs the part of a after the whole number, from 0 up to 1. Connect a growing value such as time to get a repeating ramp.";
"ec.n.th.frameIndex" = "Frame index";
"ec.n.th.frameIndex.help" = "Animation frame float: time × fps modulo frames.";
"ec.n.th.frameIndex.use" = "Outputs the animation frame float as time times fps, modulo frames. Connect time and set fps and frames to step through animation frames.";
"ec.n.th.frameRandom" = "Frame random";
"ec.n.th.frameRandom.help" = "Random value that changes once per frame: hash of (time × fps).";
"ec.n.th.frameRandom.use" = "Outputs a random value that changes once per frame, based on time times fps. Connect time and set fps to control how often it changes.";
"ec.n.th.ge" = "Greater or equal";
"ec.n.th.ge.help" = "True when a is at least b.";
"ec.n.th.ge.use" = "Outputs yes when a is at least b. Use it as a condition for Select or logic nodes.";
"ec.n.th.gray" = "Luminance";
"ec.n.th.gray.help" = "Brightness of a color from 0 (black) to 1 (white).";
"ec.n.th.gray.use" = "Outputs the brightness of the color from 0 (black) to 1 (white) as a float. Use it to read how light a color is.";
"ec.n.th.grayColor" = "Grey from float";
"ec.n.th.grayColor.help" = "A grey color with brightness v from 0 to 1.";
"ec.n.th.grayColor.use" = "Outputs a grey color with brightness v from 0 to 1. Connect a float to v to get a shade of grey.";
"ec.n.th.grid" = "Grid";
"ec.n.th.grid.help" = "Grid: 1 on lines of width line, 0 inside the cells.";
"ec.n.th.grid.use" = "Outputs 1 on grid lines of width line spaced by cell and 0 inside the cells. Use it for a grid overlay.";
"ec.n.th.gt" = "Greater than";
"ec.n.th.gt.help" = "True when a is greater than b.";
"ec.n.th.gt.use" = "Outputs yes when a is greater than b. Use it as a condition for Select or logic nodes.";
"ec.n.th.hashStep" = "Random step";
"ec.n.th.hashStep.help" = "A random float that changes every period seconds.";
"ec.n.th.hashStep.use" = "Outputs a random float that changes every period seconds. Connect time and set period to control how often it changes.";
"ec.n.th.hsv" = "Color from HSV";
"ec.n.th.hsv.help" = "Color from hue in degrees, saturation and value (0 to 1).";
"ec.n.th.hsv.use" = "Builds a color from hue h in degrees, saturation s and value v (0 to 1). Connect a hue that changes over time, such as from Time, to animate the color.";
"ec.n.th.hypot" = "Hypotenuse";
"ec.n.th.hypot.help" = "Vector length: √(a² + b²).";
"ec.n.th.hypot.use" = "Outputs the length of a vector with sides a and b, the square root of a squared plus b squared. Use it for a 2D distance from two offsets.";
"ec.n.th.int" = "Integer";
"ec.n.th.int.help" = "A whole number from its parameter, rounded.";
"ec.n.th.int.use" = "Source with no inputs: outputs the whole number from value, rounded. Use it for fixed counts or indexes.";
"ec.n.th.integrate" = "Integrate";
"ec.n.th.integrate.help" = "Adds x × frame time every frame: the running total of x over time.";
"ec.n.th.integrate.use" = "Adds x times frame time every frame, so the output is the running total of x over time. Connect a rate such as speed to x.";
"ec.n.th.inverseLerp" = "Inverse lerp";
"ec.n.th.inverseLerp.help" = "Where a lies between lo and hi: (a − lo) ÷ (hi − lo).";
"ec.n.th.inverseLerp.use" = "Gives where a lies between lo and hi as a fraction, 0 at lo and 1 at hi. Use it to turn a value into a 0 to 1 position.";
"ec.n.th.invert" = "Invert color";
"ec.n.th.invert.help" = "Inverts a color; its alpha is kept.";
"ec.n.th.invert.use" = "Inverts the color and keeps its alpha. Connect any color to color.";
"ec.n.th.key" = "Key held";
"ec.n.th.key.help" = "True while the key named in the parameter is held down, for example Space, A or Left.";
"ec.n.th.key.use" = "Source with no inputs: outputs yes while the key named in key is held down, for example Space, A or Left. Connect it to a boolean input.";
"ec.n.th.keyHeld" = "Key held";
"ec.n.th.keyHeld.help" = "True while the chosen key is held down.";
"ec.n.th.keyHeld.use" = "Source with no inputs: outputs yes while the chosen key in key is held down. Connect it to a boolean input.";
"ec.n.th.keyPressed" = "Key pressed";
"ec.n.th.keyPressed.help" = "True for one frame each time the chosen key is pressed.";
"ec.n.th.keyPressed.use" = "Source with no inputs: outputs yes for one frame each time the key in key is pressed. Use it to trigger a single action.";
"ec.n.th.keys4" = "Four keys";
"ec.n.th.keys4.help" = "Blends smoothly between four values v0…v3 as x goes from 0 to 1.";
"ec.n.th.keys4.use" = "Blends smoothly between the four values v0 to v3 as x goes from 0 to 1. Connect a 0 to 1 progress value to x and set the four values.";
"ec.n.th.le" = "Less or equal";
"ec.n.th.le.help" = "True when a is at most b.";
"ec.n.th.le.use" = "Outputs yes when a is at most b. Use it as a condition for Select or logic nodes.";
"ec.n.th.lerp" = "Lerp";
"ec.n.th.lerp.help" = "Blend from a to b: a + (b − a) × t.";
"ec.n.th.lerp.use" = "Blends from a to b by t, so t 0 gives a and t 1 gives b. Drive t with a value from 0 to 1.";
"ec.n.th.log" = "Natural log";
"ec.n.th.log.help" = "Natural logarithm of a; 0 for a of 0 or less.";
"ec.n.th.log.use" = "Outputs the natural logarithm of a, or 0 when a is 0 or less. Keep a above 0 to get a meaningful result.";
"ec.n.th.loop" = "Loop";
"ec.n.th.loop.help" = "Share of a period from 0 to 1: time wrapped to period.";
"ec.n.th.loop.use" = "Outputs the share of a period from 0 to 1 by wrapping time to period. Connect time and set period for a repeating cycle.";
"ec.n.th.lt" = "Less than";
"ec.n.th.lt.help" = "True when a is less than b.";
"ec.n.th.lt.use" = "Outputs yes when a is less than b. Use it as a condition for Select or logic nodes.";
"ec.n.th.max" = "Maximum";
"ec.n.th.max.help" = "The larger of a and b.";
"ec.n.th.max.use" = "Outputs the larger of a and b. Use it to set a minimum value.";
"ec.n.th.min" = "Minimum";
"ec.n.th.min.help" = "The smaller of a and b.";
"ec.n.th.min.use" = "Outputs the smaller of a and b. Use it to cap a value at a maximum.";
"ec.n.th.mix" = "Mix colors";
"ec.n.th.mix.help" = "Blends colors a and b by t (0 = a, 1 = b).";
"ec.n.th.mix.use" = "Blends colors a and b by t: t 0 gives a, t 1 gives b. Drive t with a value from 0 to 1.";
"ec.n.th.mod" = "Modulo";
"ec.n.th.mod.help" = "a modulo b, always from 0 up to b.";
"ec.n.th.mod.use" = "Outputs a modulo b, from 0 up to b. Use it to repeat a value every b units.";
"ec.n.th.mouseDown" = "Mouse button";
"ec.n.th.mouseDown.help" = "True while the chosen mouse button is held down over the scene.";
"ec.n.th.mouseDown.use" = "Source with no inputs: outputs yes while the button chosen in button is held down over the scene. Connect it to a boolean input to react to clicks or drags.";
"ec.n.th.mouseDX" = "Pointer move X";
"ec.n.th.mouseDX.help" = "Pointer movement in x since the last frame.";
"ec.n.th.mouseDX.use" = "Source with no inputs: outputs the pointer movement in x since the last frame. Use it for dragging or motion effects.";
"ec.n.th.mouseDY" = "Pointer move Y";
"ec.n.th.mouseDY.help" = "Pointer movement in y since the last frame.";
"ec.n.th.mouseDY.use" = "Source with no inputs: outputs the pointer movement in y since the last frame. Use it for dragging or motion effects.";
"ec.n.th.mouseSpeed" = "Pointer speed";
"ec.n.th.mouseSpeed.help" = "How far the pointer moved in this frame.";
"ec.n.th.mouseSpeed.use" = "Source with no inputs: outputs how far the pointer moved in this frame. Use it to react to fast mouse movement.";
"ec.n.th.mouseX" = "Pointer X";
"ec.n.th.mouseX.help" = "Pointer x in scene coordinates, 0 to 960.";
"ec.n.th.mouseX.use" = "Source with no inputs: outputs the pointer x position in scene coordinates, from 0 to 960. Connect it to position inputs to follow the pointer.";
"ec.n.th.mouseY" = "Pointer Y";
"ec.n.th.mouseY.help" = "Pointer y in scene coordinates, 0 to 540.";
"ec.n.th.mouseY.use" = "Source with no inputs: outputs the pointer y position in scene coordinates, from 0 to 540. Connect it to position inputs to follow the pointer.";
"ec.n.th.mul" = "Multiply";
"ec.n.th.mul.help" = "Product: a × b.";
"ec.n.th.mul.use" = "Outputs a times b. Set a and b on the right or connect values to them.";
"ec.n.th.multiplyColor" = "Multiply colors";
"ec.n.th.multiplyColor.help" = "Multiplies two colors channel by channel.";
"ec.n.th.multiplyColor.use" = "Multiplies two colors channel by channel, so a light color in b tints a. Connect the colors to a and b.";
"ec.n.th.neg" = "Negate";
"ec.n.th.neg.help" = "Changes the sign: −a.";
"ec.n.th.neg.use" = "Outputs the negative of a, changing its sign. Connect any float to a.";
"ec.n.th.noise" = "Noise";
"ec.n.th.noise.help" = "Smooth random noise from 0 to 1 over input a; the same seed gives the same noise.";
"ec.n.th.noise.use" = "Outputs smooth random noise from 0 to 1 over a, and the same seed gives the same noise. Connect a time or position value to a.";
"ec.n.th.noise2" = "Noise 2D";
"ec.n.th.noise2.help" = "Smooth noise over two coordinates from 0 to 1; seed sets the pattern.";
"ec.n.th.noise2.use" = "Outputs smooth noise over x and y from 0 to 1. Change seed to get a different pattern.";
"ec.n.th.not" = "Not";
"ec.n.th.not.help" = "True when a is false.";
"ec.n.th.not.use" = "Outputs yes when a is no, and no when a is yes. Connect a condition to a.";
"ec.n.th.number" = "Float";
"ec.n.th.number.help" = "A constant float. Set its value in the properties on the right.";
"ec.n.th.number.use" = "Source with no inputs: outputs the constant float set in value on the right. Connect it wherever a fixed float is needed.";
"ec.n.th.or" = "Or";
"ec.n.th.or.help" = "True when a or b is true.";
"ec.n.th.or.use" = "Outputs yes when a or b, or both, is yes. Connect two conditions to a and b.";
"ec.n.th.pingPong" = "Ping-pong";
"ec.n.th.pingPong.help" = "Goes from 0 to 1 and back as x grows.";
"ec.n.th.pingPong.use" = "Goes from 0 to 1 and back as x grows, repeating. Connect a growing time value to x to make a back-and-forth motion.";
"ec.n.th.polygonMask" = "Polygon mask";
"ec.n.th.polygonMask.help" = "Mask of a regular polygon with the given sides, centred at x, y; softness sets the soft edge.";
"ec.n.th.polygonMask.use" = "Outputs 1 inside a regular polygon with the given sides, centred at x, y with the radius and angle set, and 0 outside. Softness sets the edge.";
"ec.n.th.pow" = "Power";
"ec.n.th.pow.help" = "a raised to the power b.";
"ec.n.th.pow.use" = "Outputs a raised to the power b. Set the exponent on b.";
"ec.n.th.pulse" = "Pulse";
"ec.n.th.pulse.help" = "Square wave: 1 for the duty share of each period, else 0.";
"ec.n.th.pulse.use" = "Outputs a square wave: 1 for the duty share of each period, otherwise 0. Connect a time value to a and set duty to control the on-time.";
"ec.n.th.quantize" = "Quantize";
"ec.n.th.quantize.help" = "Rounds x to steps: a staircase of values.";
"ec.n.th.quantize.use" = "Rounds x to the given float of steps, giving a staircase of values. Set steps to change how many levels there are.";
"ec.n.th.rad" = "To radians";
"ec.n.th.rad.help" = "Converts a from degrees to radians.";
"ec.n.th.rad.use" = "Converts the angle on a from degrees to radians. Use it before a trig node when your angle is in degrees.";
"ec.n.th.random" = "Random";
"ec.n.th.random.help" = "A pseudo-random number from 0 to 1. The same seed gives the same float.";
"ec.n.th.random.use" = "Source with no inputs: outputs a pseudo-random number from 0 to 1. The same seed always gives the same float; change seed for another.";
"ec.n.th.randomOnEdge" = "Random on edge";
"ec.n.th.randomOnEdge.help" = "A new random value (0..1) on every rising edge of the input.";
"ec.n.th.randomOnEdge.use" = "Outputs a new random value from 0 to 1 on every rising edge of in and holds it until the next one. Connect a trigger to in.";
"ec.n.th.remap" = "Remap range";
"ec.n.th.remap.help" = "Maps a from [inLo, inHi] to [outLo, outHi].";
"ec.n.th.remap.use" = "Maps a from the input range inLo to inHi onto the output range outLo to outHi. Set the four bounds to rescale any value.";
"ec.n.th.rgb" = "Color from RGB";
"ec.n.th.rgb.help" = "Builds a color from red, green, blue (0–255) and alpha (0–1).";
"ec.n.th.rgb.use" = "Builds a color from red, green and blue (0 to 255) and alpha (0 to 1). Connect values to r, g, b and a, or set them on the right.";
"ec.n.th.ringMask" = "Ring mask";
"ec.n.th.ringMask.help" = "1 on a ring of width thickness, 0 off it.";
"ec.n.th.ringMask.use" = "Outputs 1 on a ring of width thickness around x, y at the given radius and 0 off it, with a soft edge set by softness.";
"ec.n.th.round" = "Round";
"ec.n.th.round.help" = "Nearest whole number to a.";
"ec.n.th.round.use" = "Outputs the nearest whole number to a. Use it to snap a value to whole steps.";
"ec.n.th.scaleColor" = "Scale color";
"ec.n.th.scaleColor.help" = "Multiplies the brightness of a color by factor.";
"ec.n.th.scaleColor.use" = "Multiplies the brightness of the color by factor. Connect a float to factor to dim or brighten it.";
"ec.n.th.sdfBox" = "Distance to box";
"ec.n.th.sdfBox.help" = "Distance from the point to the box edge: negative inside.";
"ec.n.th.sdfBox.use" = "Outputs the distance from the point x, y to the edge of a box with half sizes halfWidth and halfHeight. Negative means inside the box.";
"ec.n.th.sdfCircle" = "Distance to circle";
"ec.n.th.sdfCircle.help" = "Distance from the point to the circle edge: negative inside.";
"ec.n.th.sdfCircle.use" = "Outputs the distance from the point x, y to the edge of a circle with the given radius. Negative means inside the circle.";
"ec.n.th.select" = "Select";
"ec.n.th.select.help" = "Gives a when cond is true, otherwise b.";
"ec.n.th.select.use" = "Outputs a when cond is yes, otherwise b. Connect a condition to cond and the two floats to a and b.";
"ec.n.th.select4" = "Select of four";
"ec.n.th.select4.help" = "Takes one of the values v0…v3 by index (modulo 4).";
"ec.n.th.select4.use" = "Outputs one of the values v0 to v3 chosen by index, using index modulo 4. Connect a whole-float index to pick the value.";
"ec.n.th.selectColor" = "Select color";
"ec.n.th.selectColor.help" = "Color a when the condition is true, otherwise color b.";
"ec.n.th.selectColor.use" = "Outputs color a when cond is yes, otherwise color b. Connect a condition to cond and the two colors to a and b.";
"ec.n.th.set.alpha" = "Set opacity";
"ec.n.th.set.alpha.help" = "Each frame, writes the value into the «alpha» property of this object.";
"ec.n.th.set.alpha.use" = "Sink: each frame writes v into the alpha property (opacity) of this object. Connect a float to v to change its opacity over time.";
"ec.n.th.set.alpha2" = "Set second opacity";
"ec.n.th.set.alpha2.help" = "Each frame, writes the value into the «alpha2» property of this object.";
"ec.n.th.set.alpha2.use" = "Sink: each frame writes v into the alpha2 property (second opacity) of this object. Connect a float to v to change it.";
"ec.n.th.set.alpha3" = "Set third opacity";
"ec.n.th.set.alpha3.help" = "Each frame, writes the value into the «alpha3» property of this object.";
"ec.n.th.set.alpha3.use" = "Sink: each frame writes v into the alpha3 property (third opacity) of this object. Connect a float to v to change it.";
"ec.n.th.set.color" = "Set color";
"ec.n.th.set.color.help" = "Each frame, writes a color into the «color» property of this object.";
"ec.n.th.set.color.use" = "Sink: each frame writes the color on v into the color property of this object. Connect a color to v to change it.";
"ec.n.th.set.color2" = "Set second color";
"ec.n.th.set.color2.help" = "Each frame, writes the value into the «color2» property of this object.";
"ec.n.th.set.color2.use" = "Sink: each frame writes the color on v into the color2 property of this object. Connect a color to v to change it.";
"ec.n.th.set.color3" = "Set third color";
"ec.n.th.set.color3.help" = "Each frame, writes the value into the «color3» property of this object.";
"ec.n.th.set.color3.use" = "Sink: each frame writes the color on v into the color3 property of this object. Connect a color to v to change it.";
"ec.n.th.set.extent" = "Set arc extent";
"ec.n.th.set.extent.help" = "Each frame, writes the value into the «extent» property of this object.";
"ec.n.th.set.extent.use" = "Sink: each frame writes v into the extent property of this object. Connect a float to v to change the arc's length.";
"ec.n.th.set.fill" = "Set fill (linear gradient)";
"ec.n.th.set.fill.help" = "Each frame, writes the value into the «fill» property of this object.";
"ec.n.th.set.fill.use" = "Sink: each frame writes the boolean value on v into the fill property of this object, which switches the linear gradient on or off.";
"ec.n.th.set.gradY0" = "Set gradient start Y";
"ec.n.th.set.gradY0.help" = "Each frame, writes the value into the «gradY0» property of this object.";
"ec.n.th.set.gradY0.use" = "Sink: each frame writes v into the gradY0 property, the gradient start Y, of this object. Connect a float to v to move the start.";
"ec.n.th.set.gradY1" = "Set gradient end Y";
"ec.n.th.set.gradY1.help" = "Each frame, writes the value into the «gradY1» property of this object.";
"ec.n.th.set.gradY1.use" = "Sink: each frame writes v into the gradY1 property, the gradient end Y, of this object. Connect a float to v to move the end.";
"ec.n.th.set.h" = "Set height";
"ec.n.th.set.h.help" = "Each frame, writes the value into the «h» property of this object.";
"ec.n.th.set.h.use" = "Sink: each frame writes v into the h property of this object. Connect a float to v to change its height.";
"ec.n.th.set.layer" = "Set layer";
"ec.n.th.set.layer.help" = "Writes the object's layer every frame. Values outside -127..128 are clamped.";
"ec.n.th.set.layer.use" = "Sink: each frame writes v as the object's layer. Values outside -127 to 128 are clamped, so keep v in that range.";
"ec.n.th.set.midAt" = "Set gradient midpoint";
"ec.n.th.set.midAt.help" = "Each frame, writes the value into the «midAt» property of this object.";
"ec.n.th.set.midAt.use" = "Sink: each frame writes v into the midAt property, the gradient midpoint, of this object. Connect a float to v to move the midpoint.";
"ec.n.th.set.points" = "Set points";
"ec.n.th.set.points.help" = "Each frame sets the four points of a polygon or polyline: x and y of each.";
"ec.n.th.set.points.use" = "Sink: each frame sets the four points of a polygon or polyline from p0x, p0y through p3x, p3y. Connect an x and y value to each pair.";
"ec.n.th.set.pointX" = "Set point X";
"ec.n.th.set.pointX.help" = "Each frame, writes the X of one point of a polygon or polyline. Choose the point number on the right.";
"ec.n.th.set.pointX.use" = "Sink: each frame writes v as the X of point number index of this object. Connect a number to v to move that point.";
"ec.n.th.set.pointY" = "Set point Y";
"ec.n.th.set.pointY.help" = "Each frame, writes the Y of one point of a polygon or polyline. Choose the point number on the right.";
"ec.n.th.set.pointY.use" = "Sink: each frame writes v as the Y of point number index of this object. Connect a number to v to move that point.";
"ec.n.th.set.radius" = "Set radius";
"ec.n.th.set.radius.help" = "Each frame, writes the value into the «radius» property of this object.";
"ec.n.th.set.radius.use" = "Sink: each frame writes v into the radius property of this object. Connect a float to v to change its size.";
"ec.n.th.set.rot" = "Set rotation Z";
"ec.n.th.set.rot.help" = "Writes the object's rotation in the plane (around Z) in degrees every frame.";
"ec.n.th.set.rot.use" = "Sink: each frame writes v as the object's rotation in degrees around Z. Connect a float to v to rotate it.";
"ec.n.th.set.rotX" = "Set rotation X";
"ec.n.th.set.rotX.help" = "Writes the object's rotation on the X axis every frame.";
"ec.n.th.set.rotY" = "Set rotation Y";
"ec.n.th.set.rotY.help" = "Writes the object's rotation on the Y axis every frame.";
"ec.n.th.set.scale" = "Set scale X";
"ec.n.th.set.scale.help" = "Writes the object's scale on the X axis every frame.";
"ec.n.th.set.scale.use" = "Sink: each frame writes v as the object's scale on X. Connect a float to v to stretch it over time.";
"ec.n.th.set.scaleY" = "Set scale Y";
"ec.n.th.set.scaleY.help" = "Writes the object's scale on the Y axis every frame.";
"ec.n.th.set.start" = "Set arc start";
"ec.n.th.set.start.help" = "Each frame, writes the value into the «start» property of this object.";
"ec.n.th.set.start.use" = "Sink: each frame writes v into the start property of this object. Connect an angle to v to change where an arc begins.";
"ec.n.th.set.stroke" = "Set stroke width";
"ec.n.th.set.stroke.help" = "Each frame, writes the value into the «stroke» property of this object.";
"ec.n.th.set.stroke.use" = "Sink: each frame writes v into the stroke property of this object. Connect a float to v to change its line width.";
"ec.n.th.set.visible" = "Set visible";
"ec.n.th.set.visible.help" = "Each frame, shows or hides this object: yes shows it, no hides it.";
"ec.n.th.set.visible.use" = "Sink: each frame writes the yes or no value on v into the visible property of this object. Connect a condition to v to show or hide the object over time.";
"ec.n.th.set.w" = "Set width";
"ec.n.th.set.w.help" = "Each frame, writes the value into the «w» property of this object.";
"ec.n.th.set.w.use" = "Sink: each frame writes v into the w property of this object. Connect a float to v to change its width.";
"ec.n.th.set.x" = "Set X";
"ec.n.th.set.x.help" = "Each frame, writes the value into the «x» property of this object.";
"ec.n.th.set.x.use" = "Sink: each frame writes v into the x property of this object. Connect a float to v to move the object horizontally.";
"ec.n.th.set.y" = "Set Y";
"ec.n.th.set.y.help" = "Each frame, writes the value into the «y» property of this object.";
"ec.n.th.set.y.use" = "Sink: each frame writes v into the y property of this object. Connect a float to v to move the object vertically.";
"ec.n.th.setColor" = "Set color and alpha";
"ec.n.th.setColor.help" = "Each frame sets the color of this object; the alpha of the color sets its alpha too.";
"ec.n.th.setColor.use" = "Sink: each frame writes the color and its alpha into this object from one color input.";
"ec.n.th.setGradient" = "Set gradient";
"ec.n.th.setGradient.help" = "Each frame sets the start and end of the gradient together.";
"ec.n.th.setGradient.use" = "Sink: each frame writes gradY0 and gradY1 of this object from its two inputs.";
"ec.n.th.setPosition" = "Set position";
"ec.n.th.setPosition.help" = "Each frame sets x and y of this object together.";
"ec.n.th.setPosition.use" = "Sink: each frame writes x and y of this object from its two inputs.";
"ec.n.th.setRotation" = "Set rotation";
"ec.n.th.setRotation.help" = "Each frame sets the rotation of this object on X, Y and Z together.";
"ec.n.th.setRotation.use" = "Sink: each frame writes rotX, rotY and rot of this object from its three inputs.";
"ec.n.th.setScale" = "Set scale (X, Y)";
"ec.n.th.setScale.help" = "Each frame sets the scale of this object on X and Y together.";
"ec.n.th.setScale.use" = "Sink: each frame writes scale and scaleY of this object from its two inputs.";
"ec.n.th.setSize" = "Set size";
"ec.n.th.setSize.help" = "Each frame sets width and height of this object together.";
"ec.n.th.setSize.use" = "Sink: each frame writes w and h of this object from its two inputs.";
"ec.n.th.sign" = "Sign";
"ec.n.th.sign.help" = "-1, 0 or 1 by the sign of a.";
"ec.n.th.sign.use" = "Outputs -1, 0 or 1 according to the sign of a. Use it to find which side of zero a value lies on.";
"ec.n.th.sin" = "Sine";
"ec.n.th.sin.help" = "Sine of a (radians).";
"ec.n.th.sin.use" = "Outputs the sine of a, with a in radians. Connect a time-based value to a to get a smooth wave.";
"ec.n.th.smooth" = "Smooth step";
"ec.n.th.smooth.help" = "Maps a from lo..hi to 0..1, with smooth edges.";
"ec.n.th.smooth.use" = "Maps a from the range lo to hi onto 0 to 1 with smooth edges. Use it to turn a value into a soft 0 to 1 transition.";
"ec.n.th.smootherstep" = "Smoother step";
"ec.n.th.smootherstep.help" = "Like Smooth step, with softer start and end (Perlin curve).";
"ec.n.th.smootherstep.use" = "Like Smooth step: maps a from lo to hi onto 0 to 1 with a softer start and end. Use it for a gentler transition.";
"ec.n.th.sqrt" = "Square root";
"ec.n.th.sqrt.help" = "Square root of a; 0 for negative a.";
"ec.n.th.sqrt.use" = "Outputs the square root of a, or 0 when a is negative. Use it for distances computed from squared sums.";
"ec.n.th.step" = "Step";
"ec.n.th.step.help" = "1 when a is at or above edge, else 0.";
"ec.n.th.step.use" = "Outputs 1 when a is at or above edge, otherwise 0. Set edge on the right or connect it.";
"ec.n.th.stripes" = "Stripes";
"ec.n.th.stripes.help" = "Stripes over x: 0 to 1 with the period period.";
"ec.n.th.stripes.use" = "Outputs stripes over x from 0 to 1, repeating with the given period. Use it for bands or repeating lines.";
"ec.n.th.sub" = "Subtract";
"ec.n.th.sub.help" = "Difference: a − b.";
"ec.n.th.sub.use" = "Outputs a minus b. Set a and b on the right or connect values to them.";
"ec.n.th.table" = "Table over time";
"ec.n.th.table.help" = "Plays values spaced evenly over the period, interpolating between them and repeating. a is the time in seconds.";
"ec.n.th.table.use" = "Plays a list of values spread evenly over period seconds, interpolating between them and repeating. Connect time to a and set the values to make a curve.";
"ec.n.th.tan" = "Tangent";
"ec.n.th.tan.help" = "Tangent of the angle a (in radians).";
"ec.n.th.tan.use" = "Outputs the tangent of the angle a in radians. Values become very large near odd multiples of pi divided by 2.";
"ec.n.th.time" = "Time";
"ec.n.th.time.help" = "Seconds since the start, times the speed (speed 1 is real time).";
"ec.n.th.time.use" = "Source with no inputs: outputs seconds since start multiplied by speed. Speed 1 is real time; use it to drive animation.";
"ec.n.th.timeSinceEdge" = "Time since edge";
"ec.n.th.timeSinceEdge.help" = "Seconds since the last rising edge of the input.";
"ec.n.th.timeSinceEdge.use" = "Outputs the seconds since the last rising edge of in. Use it to time an effect that starts on an event.";
"ec.n.th.toBool" = "To boolean";
"ec.n.th.toBool.help" = "A float as a boolean: true when above 0.5.";
"ec.n.th.toBool.use" = "Converts the float on a to boolean, yes when a is above 0.5. Use it to turn a float into a condition.";
"ec.n.th.toggle" = "Toggle";
"ec.n.th.toggle.help" = "Flips its output on every rising edge of the input.";
"ec.n.th.toggle.use" = "Flips its boolean output each time the input has a rising edge. Connect a trigger such as a key press to in for an on-off switch.";
"ec.n.th.toNumber" = "To float";
"ec.n.th.toNumber.help" = "A boolean as a float: true → 1, false → 0.";
"ec.n.th.toNumber.use" = "Converts a boolean value on a to a float: yes gives 1, no gives 0. Use it to add or multiply by a condition.";
"ec.n.th.tri" = "Triangle wave";
"ec.n.th.tri.help" = "Rises from 0 to 1 and back, once every unit of a.";
"ec.n.th.tri.use" = "Outputs a triangle wave that rises from 0 to 1 and falls back once every unit of a. Connect a time value to a for a steady back-and-forth.";
"ec.n.th.wave" = "Wave";
"ec.n.th.wave.help" = "Periodic wave over x: sine, triangle, saw or square, from −1 to 1.";
"ec.n.th.wave.use" = "Outputs a periodic wave over x from -1 to 1 in the shape chosen by shape: sine, triangle, saw or square. Connect a time value to x for animation.";
"ec.n.th.xor" = "Exclusive or";
"ec.n.th.xor.help" = "True when exactly one input is true.";
"ec.n.th.xor.use" = "Outputs yes when exactly one of a and b is yes. Connect two conditions to a and b.";
"ec.n.time" = "Time";
"ec.n.time.help" = "Seconds since the engine started. For animation and flicker.";
"ec.n.time.use" = "Source with no inputs: out gives the seconds since the engine started. Connect it to t of Wave with freq set to make a pulse that repeats over time.";
"ec.n.toFloat" = "To float";
"ec.n.toFloat.help" = "Converts an integer to a float.";
"ec.n.toFloat.use" = "Converts the whole number on a to a float on out. Use it before combining an integer such as pixelX with decimal math.";
"ec.n.toInt" = "To integer";
"ec.n.toInt.help" = "Drops the fractional part (rounds down).";
"ec.n.toInt.use" = "Converts the float on a to a whole number on out by dropping the fraction, which rounds down. Use it for cell indexes or steps.";
"ec.n.valueNoise" = "Value noise";
"ec.n.valueNoise.help" = "Smooth random pattern over (x, y). Same seed gives the same pattern; change the seed for a new one.";
"ec.n.valueNoise.use" = "Outputs a smooth random pattern over x and y. The same seed gives the same pattern; change seed for a new one.";
"ec.n.wallNormal" = "Wall normal";
"ec.n.wallNormal.help" = "Direction the hit wall faces, from the ray direction and the hit side (side 0 = x face, 1 = y face).";
"ec.n.wallNormal.use" = "Gives the direction the hit wall faces, nx and ny, from the ray direction and the hit side: 0 is an x face, 1 is a y face. Use it for wall lighting.";
"ec.n.wave" = "Wave";
"ec.n.wave.help" = "Smooth 0..1 wave: 0.5 + 0.5·sin(t·freq). Use time as t for pulsing.";
"ec.n.wave.use" = "Outputs a smooth wave from 0 to 1 as 0.5 plus 0.5 times the sine of t times freq. Connect Time to t and set freq to set the pulse rate.";
"ec.n.width" = "Width";
"ec.n.width.help" = "Picture width in pixels.";
"ec.n.width.use" = "Source with no inputs: out gives the picture width in pixels. Use it wherever a calculation needs the image size.";
"ec.n.xor" = "Exclusive or";
"ec.n.xor.help" = "True when exactly one of the two conditions is true.";
"ec.n.xor.use" = "Outputs yes when exactly one of a and b is yes. Use it to flip a condition only when one of two is true.";

